    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
